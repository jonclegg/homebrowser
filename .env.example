# Stealthbox settings. start.sh / start.ps1 copies this file to .env on first run.
# Edit .env (not this file), then run: stealthbox start

# Optional. Send all browser traffic through a proxy.
# Examples: http://user:pass@host:8080   socks5://host:1080
STEALTHBOX_PROXY=

# Optional. Any number or word (letters, digits, - and _) to choose the browser
# fingerprint. Left blank, Stealthbox picks one on first start and keeps it with
# the saved profile, so the fingerprint survives restarts either way.
STEALTHBOX_FINGERPRINT_SEED=

# Change these only if something else on your computer already uses the port.
STEALTHBOX_CDP_PORT=9222
STEALTHBOX_VIEWER_PORT=6080

# The container's clock. Leave this commented to use this computer's timezone.
# The browser itself reports the timezone and locale of the IP its traffic
# leaves from (GeoIP), so a proxy gets its own exit's clock.
# TZ=America/Chicago

# Optional. The model behind `stealthbox chat`; it must accept images.
STEALTHBOX_MODEL=deepseek/deepseek-v4.1-flash

# Change this only if something else on your computer already uses the port.
STEALTHBOX_API_PORT=8423

# Each session works in a browser of its own, so sessions run at the same time.
# This many are open at once; each takes about 1 GB of memory and a CPU core
# while it works. At the limit a new session takes the browser of the one that
# finished longest ago, or waits.
STEALTHBOX_SESSION_BROWSERS=3
