def _ws_scheme(request: web.Request) -> str:
    """Return 'wss' if client connected via HTTPS (e.g. TLS-terminating proxy), else 'ws'."""
    proto = request.headers.get("X-Forwarded-Proto", request.scheme)
    proto = proto.split(",", 1)[0].strip().lower()
    return "wss" if proto == "https" else "ws"


def _external_host(request: web.Request) -> str:
    """Return the public host to use in rewritten CDP WebSocket URLs."""
    fallback_host = request.headers.get("Host") or f"localhost:{request.app['port']}"
    forwarded_host = request.headers.get("X-Forwarded-Host")
    if forwarded_host:
        public_host = forwarded_host.split(",", 1)[0].strip()
        if public_host:
            return public_host
    return fallback_host


async def handle_close(request: web.Request) -> web.Response:
    """Terminate one seed's browser on demand, freeing its slot immediately.

    Idempotent: closing a seed that is not running returns terminated=false, 200.
    The persistent profile is kept, so reopening the seed restores its identity.
    """
    pool: ChromePool = request.app["pool"]
    seed = request.match_info.get("seed", "")
    terminated = await pool.terminate_seed(seed)
    return web.json_response({"seed": seed, "terminated": terminated})


# ---------------------------------------------------------------------------
# Native input — real X11 events through xdotool (headed mode only)
#
# CDP Input.dispatch* events are trusted, but they skip the OS input pipeline.
# This drives the same X display the browser renders on, so events arrive the
# way a physical mouse and keyboard deliver them. Coordinates are viewport CSS
# pixels of one page target, mapped to the screen from the real window bounds.
# ---------------------------------------------------------------------------

INPUT_ACTION_TYPES = {"move", "path", "down", "up", "click", "wheel", "type", "key", "sleep"}


def xdotool_commands(action: dict, origin: tuple[int, int], zoom: float = 1.0) -> list[tuple[float, list[str]]]:
    """Translate one input action into (delay_seconds, xdotool argv) steps.

    Coordinates are CSS pixels; zoom (page zoom times device scale factor)
    scales them to X11 pixels.
    """
    kind = action["type"]
    left, top = origin

    def move(x: float, y: float) -> list[str]:
        return ["mousemove", str(round(left + x * zoom)), str(round(top + y * zoom))]

    if kind == "move":
        return [(0.0, move(action["x"], action["y"]))]
    if kind == "path":
        return [(point[2] / 1000.0, move(point[0], point[1])) for point in action["points"]]
    if kind in ("down", "up"):
        return [(0.0, [f"mouse{kind}", str(action.get("button", 1))])]
    if kind == "click":
        steps = [(0.0, move(action["x"], action["y"]))] if "x" in action else []
        return steps + [(0.0, ["click", str(action.get("button", 1))])]
    if kind == "wheel":
        button = "4" if action.get("direction", "down") == "up" else "5"
        return [(0.0, ["click", "--repeat", str(action.get("clicks", 1)), "--delay", "60", button])]
    if kind == "type":
        return [(0.0, ["type", "--delay", str(action.get("delay_ms", 90)), "--", action["text"]])]
    if kind == "key":
        return [(0.0, ["key", "--", action["keys"]])]
    if kind == "sleep":
        return [(action["ms"] / 1000.0, [])]
    raise ValueError(f"unknown input action type: {kind!r}")


async def _run_xdotool(argv: list[str]) -> None:
    process = await asyncio.create_subprocess_exec(
        "xdotool", *argv, stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.PIPE,
    )
    _, stderr = await process.communicate()
    if process.returncode != 0:
        raise RuntimeError(f"xdotool {' '.join(argv)} failed: {stderr.decode().strip()}")


def _reject_display_request(request: web.Request) -> web.Response | None:
    """Guard for POST endpoints that act on the X display: local JSON callers only."""
    if request.headers.get("Origin") is not None and not _origin_is_allowed(
        request.headers.get("Origin"), request.headers.get("Host"),
    ):
        return web.json_response({"error": "untrusted origin"}, status=403)
    if request.content_type != "application/json":
        return web.json_response({"error": "Content-Type must be application/json"}, status=415)
    if not os.environ.get("DISPLAY"):
        return web.json_response({"error": "needs a headed browser on an X display (DISPLAY unset)"}, status=501)
    return None


def _page_target(body: dict) -> str | None:
    target = body.get("target")
    if isinstance(target, str) and re.fullmatch(r"[A-Fa-f0-9]{8,64}", target):
        return target
    return None


async def handle_window(request: web.Request) -> web.Response:
    """Re-settle one page's window to a coherent size: POST {"target": id}.

    For callers that find the window shrunk or maximized by another client.
    """
    rejected = _reject_display_request(request)
    if rejected is not None:
        return rejected
    target = _page_target(await request.json())
    if target is None:
        return web.json_response({"error": "target must be a page target id"}, status=400)
    pool: ChromePool = request.app["pool"]
    cp = await pool.get_or_launch(seed=request.match_info.get("seed"))
    async with websockets.connect(f"ws://127.0.0.1:{cp.cdp_port}/devtools/page/{target}", max_size=None) as ws:
        geometry = await settle_window(CdpSession(ws))
    return web.json_response({"ok": True, "geometry": geometry})


async def handle_input(request: web.Request) -> web.Response:
    """Run native input actions against one page: POST {"target": id, "actions": [...]}."""
    rejected = _reject_display_request(request)
    if rejected is not None:
        return rejected

    body = await request.json()
    target = _page_target(body)
    actions = body.get("actions")
    if target is None:
        return web.json_response({"error": "target must be a page target id"}, status=400)
    if not isinstance(actions, list) or not all(
        isinstance(action, dict) and action.get("type") in INPUT_ACTION_TYPES for action in actions
    ):
        return web.json_response({"error": f"actions must be objects with type in {sorted(INPUT_ACTION_TYPES)}"}, status=400)

    pool: ChromePool = request.app["pool"]
    cp = await pool.get_or_launch(seed=request.match_info.get("seed"))

    async with websockets.connect(f"ws://127.0.0.1:{cp.cdp_port}/devtools/page/{target}", max_size=None) as ws:
        cdp = CdpSession(ws)
        await cdp.send("Page.bringToFront")
        window = await cdp.send("Browser.getWindowForTarget")
        metrics = await cdp.send("Page.getLayoutMetrics")
    viewport = metrics["visualViewport"]
    if viewport.get("scale", 1) != 1:
        return web.json_response({"error": "native input needs a page without pinch zoom"}, status=409)
    # CSS -> device pixels covers page zoom and the device scale factor together
    zoom = viewport["clientWidth"] / metrics["cssVisualViewport"]["clientWidth"]
    device_scale_factor = zoom / viewport.get("zoom", 1)
    origin = viewport_origin(window["bounds"], viewport["clientHeight"], device_scale_factor)

    for action in actions:
        for delay, argv in xdotool_commands(action, origin, zoom):
            if delay:
                await asyncio.sleep(delay)
            if argv:
                await _run_xdotool(argv)
    return web.json_response({"ok": True, "origin": list(origin), "zoom": zoom, "actions": len(actions)})


async def handle_root(request: web.Request) -> web.Response:
    """Health check / process status."""
    pool: ChromePool = request.app["pool"]
    processes = {}
    for key, proc in pool._processes.items():
        if proc.process.poll() is None:
            processes[key] = {
                "pid": proc.process.pid,
                "port": proc.cdp_port,
                "seed": proc.seed,
                "connections": pool._connections.get(key, 0),
                "idle_cleanup_pending": key in pool._idle_tasks,
                "timezone": proc.timezone,
                "locale": proc.locale,
                "proxy": proc.proxy,
                "geoip": proc.geoip,
            }
    return web.json_response({
        "status": "ok",
        "active": len(processes),
        "max_processes": pool._max_processes,
        "idle_timeout": pool._idle_timeout,
        "processes": processes,
    })


async def handle_history(request: web.Request) -> web.Response:
    """Addresses from the default identity's history for an address bar: GET /history?q=.

    Chrome keeps its profile to the user it runs as (mode 700); a caller running
    as another user asks here.
    """
    pool: ChromePool = request.app["pool"]
    profile = os.path.join(pool._data_dir, pool.default_key)
    found = await asyncio.to_thread(history.suggestions, profile, request.query.get("q", ""))
    return web.json_response({"suggestions": found})


async def handle_json_version(request: web.Request) -> web.Response:
    """Proxy /json/version with optional per-seed routing."""
    pool: ChromePool = request.app["pool"]
    params = parse_connection_params(request.query_string)

    cp = await pool.get_or_launch(
        seed=params["seed"],
        extra_args=params["extra_args"] or None,
        timezone=params["timezone"],
        locale=params["locale"],
        proxy=params["proxy"],
        geoip=params["geoip"],
    )

    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"http://127.0.0.1:{cp.cdp_port}/json/version",
                timeout=aiohttp.ClientTimeout(total=5),
            ) as resp:
                data = await resp.json()
    except Exception as exc:
        logger.error("Failed to reach Chrome CDP (port %d): %s", cp.cdp_port, exc)
        return web.json_response({"error": "CDP endpoint unreachable"}, status=502)

    # Rewrite webSocketDebuggerUrl to route through our multiplexer
    host = _external_host(request)
    seed_key = params["seed"]
    if seed_key:
        ws_path = f"fingerprint/{seed_key}/devtools/browser"
    else:
        ws_path = "devtools/browser"

    # Extract the browser GUID from Chrome's original URL
    orig_ws = data.get("webSocketDebuggerUrl", "")
    guid = orig_ws.rsplit("/", 1)[-1] if "/devtools/" in orig_ws else ""

    scheme = _ws_scheme(request)
    data["webSocketDebuggerUrl"] = f"{scheme}://{host}/{ws_path}/{guid}"
    return web.json_response(data)


async def handle_json_list(request: web.Request) -> web.Response:
    """Proxy /json/list with per-seed routing. Rewrites all entries."""
    pool: ChromePool = request.app["pool"]
    params = parse_connection_params(request.query_string)

    cp = await pool.get_or_launch(
        seed=params["seed"],
        extra_args=params["extra_args"] or None,
        timezone=params["timezone"],
        locale=params["locale"],
        proxy=params["proxy"],
        geoip=params["geoip"],
    )

    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"http://127.0.0.1:{cp.cdp_port}/json/list",
                timeout=aiohttp.ClientTimeout(total=5),
            ) as resp:
                data = await resp.json()
    except Exception as exc:
        logger.error("Failed to reach Chrome CDP (port %d): %s", cp.cdp_port, exc)
        return web.json_response({"error": "CDP endpoint unreachable"}, status=502)

    host = _external_host(request)
    scheme = _ws_scheme(request)
    seed_key = params["seed"]

    for entry in data:
        if "webSocketDebuggerUrl" in entry:
            ws_tail = entry["webSocketDebuggerUrl"].split("/devtools/")[-1]
            if seed_key:
                entry["webSocketDebuggerUrl"] = (
                    f"{scheme}://{host}/fingerprint/{seed_key}/devtools/{ws_tail}"
                )
            else:
                entry["webSocketDebuggerUrl"] = f"{scheme}://{host}/devtools/{ws_tail}"

    return web.json_response(data)


# ---------------------------------------------------------------------------
# WebSocket proxy
# ---------------------------------------------------------------------------

async def proxy_cdp_websocket(
    client_ws: web.WebSocketResponse,
    target_url: str,
    label: str,
) -> None:
    """Bidirectional WebSocket proxy between client and Chrome CDP."""
    try:
        async with websockets.connect(
            target_url, max_size=None, ping_interval=None, ping_timeout=None,
        ) as cdp_ws:
            logger.info("%s: connected to %s", label, target_url)

            async def client_to_cdp():
                try:
                    async for msg in client_ws:
                        if msg.type == aiohttp.WSMsgType.TEXT:
                            await cdp_ws.send(msg.data)
                        elif msg.type == aiohttp.WSMsgType.BINARY:
                            await cdp_ws.send(msg.data)
                        elif msg.type in (aiohttp.WSMsgType.CLOSE, aiohttp.WSMsgType.CLOSING, aiohttp.WSMsgType.CLOSED):
                            break
                except Exception as exc:
                    logger.debug("%s [c->cdp]: %s", label, exc)

            async def cdp_to_client():
                try:
                    async for msg in cdp_ws:
                        if isinstance(msg, str):
                            await client_ws.send_str(msg)
                        else:
                            await client_ws.send_bytes(msg)
                except Exception as exc:
                    logger.debug("%s [cdp->c]: %s", label, exc)

            c2d = asyncio.create_task(client_to_cdp(), name="c2d")
            d2c = asyncio.create_task(cdp_to_client(), name="d2c")
            done, pending = await asyncio.wait(
                [c2d, d2c], return_when=asyncio.FIRST_COMPLETED,
            )
            for task in pending:
                task.cancel()
            logger.info("%s: disconnected", label)

    except Exception as exc:
        logger.error("%s error: %s", label, exc)


async def handle_ws_default(request: web.Request) -> web.StreamResponse:
    """WebSocket proxy for default (no-seed) Chrome: /devtools/{type}/{guid}"""
    rejected = _reject_untrusted_origin(request)
    if rejected is not None:
        return rejected

    pool: ChromePool = request.app["pool"]
    path = request.match_info.get("path", "")

    cp = await pool.get_or_launch(seed=None)

    ws = web.WebSocketResponse()
    await ws.prepare(request)

    pool.connect(pool.default_key)
    try:
        target_url = f"ws://127.0.0.1:{cp.cdp_port}/devtools/{path}"
        await proxy_cdp_websocket(ws, target_url, f"CDP default [{path}]")
    finally:
        pool.disconnect(pool.default_key)
    return ws


async def handle_ws_seed(request: web.Request) -> web.StreamResponse:
    """WebSocket proxy for seed-specific Chrome: /fingerprint/{seed}/devtools/{type}/{guid}"""
    rejected = _reject_untrusted_origin(request)
    if rejected is not None:
        return rejected

    pool: ChromePool = request.app["pool"]
    seed = request.match_info["seed"]
    path = request.match_info.get("path", "")

    cp = await pool.get_or_launch(seed=seed)

    ws = web.WebSocketResponse()
    await ws.prepare(request)

    pool.connect(seed)
    try:
        target_url = f"ws://127.0.0.1:{cp.cdp_port}/devtools/{path}"
        await proxy_cdp_websocket(ws, target_url, f"CDP seed={seed} [{path}]")
    finally:
        pool.disconnect(seed)
    return ws


async def on_shutdown(app: web.Application) -> None:
    await app["pool"].shutdown()


# ---------------------------------------------------------------------------
# CLI arg parsing
