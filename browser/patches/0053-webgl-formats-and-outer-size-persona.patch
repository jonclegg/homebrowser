+// Fury: texture-format extensions the persona's GPU has and SwiftShader lacks.
+// Chrome on a Mac offers ASTC, ETC, ETC1 and PVRTC (and, in WebGL 2, shared
+// exponent rendering), and enabling them only adds format enums to what the
+// context accepts, so they can be granted without a backend. Uploading data in
+// one of those formats still fails, as there is no decoder behind it.
+bool WebGLRenderingContextBase::PersonaListsFormatExtension(
+    const ExtensionTracker* tracker) {
+  static constexpr std::string_view kFormatExtensions[] = {
+      "WEBGL_compressed_texture_astc", "WEBGL_compressed_texture_etc",
+      "WEBGL_compressed_texture_etc1", "WEBGL_compressed_texture_pvrtc",
+      "WEBGL_render_shared_exponent"};
+  const std::string name = String(tracker->ExtensionName()).Utf8();
+  if (std::ranges::find(kFormatExtensions, name) ==
+      std::end(kFormatExtensions)) {
+    return false;
+  }
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config) {
+    return false;
+  }
+  std::optional<std::vector<std::string>> persona = config->GetStringList(
+      IsWebGL2() ? "gpu.webgl2Extensions" : "gpu.webglExtensions");
+  return persona && std::ranges::find(*persona, name) != persona->end();
+}
