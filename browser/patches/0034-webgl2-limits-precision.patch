+// The WebGL2 limits, by the name tools/detect-suite and the persona use. The
+// WebGL1 limits are 0031's; a WebGL2 context answers these before ever reaching
+// that code, so in a container they came straight from SwiftShader while the
+// renderer string said Apple: MAX_SAMPLES 4, MAX_ELEMENTS_INDICES 3000,
+// MIN_PROGRAM_TEXEL_OFFSET -32 against a real M-series Mac's 8, 2147483647, -8.
+// The type is the one the switch below reports, because the JS type is itself
+// part of the answer.
+enum class FuryLimitType { kInt, kInt64, kFloat };
+
+struct FuryWebGL2LimitName {
+  GLenum pname;
+  const char* name;
+  FuryLimitType type;
+};
+
+constexpr FuryWebGL2LimitName kFuryWebGL2Limits[] = {
+    {GL_MAX_3D_TEXTURE_SIZE, "MAX_3D_TEXTURE_SIZE", FuryLimitType::kInt},
+    {GL_MAX_ARRAY_TEXTURE_LAYERS, "MAX_ARRAY_TEXTURE_LAYERS", FuryLimitType::kInt},
+    {GL_MAX_COLOR_ATTACHMENTS, "MAX_COLOR_ATTACHMENTS", FuryLimitType::kInt},
+    {GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS, "MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS", FuryLimitType::kInt64},
+    {GL_MAX_COMBINED_UNIFORM_BLOCKS, "MAX_COMBINED_UNIFORM_BLOCKS", FuryLimitType::kInt},
+    {GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS, "MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS", FuryLimitType::kInt64},
+    {GL_MAX_DRAW_BUFFERS, "MAX_DRAW_BUFFERS", FuryLimitType::kInt},
+    {GL_MAX_ELEMENT_INDEX, "MAX_ELEMENT_INDEX", FuryLimitType::kInt64},
+    {GL_MAX_ELEMENTS_INDICES, "MAX_ELEMENTS_INDICES", FuryLimitType::kInt},
+    {GL_MAX_ELEMENTS_VERTICES, "MAX_ELEMENTS_VERTICES", FuryLimitType::kInt},
+    {GL_MAX_FRAGMENT_INPUT_COMPONENTS, "MAX_FRAGMENT_INPUT_COMPONENTS", FuryLimitType::kInt},
+    {GL_MAX_FRAGMENT_UNIFORM_BLOCKS, "MAX_FRAGMENT_UNIFORM_BLOCKS", FuryLimitType::kInt},
+    {GL_MAX_FRAGMENT_UNIFORM_COMPONENTS, "MAX_FRAGMENT_UNIFORM_COMPONENTS", FuryLimitType::kInt},
+    {GL_MAX_PROGRAM_TEXEL_OFFSET, "MAX_PROGRAM_TEXEL_OFFSET", FuryLimitType::kInt},
+    {GL_MAX_SAMPLES, "MAX_SAMPLES", FuryLimitType::kInt},
+    {GL_MAX_SERVER_WAIT_TIMEOUT, "MAX_SERVER_WAIT_TIMEOUT", FuryLimitType::kInt64},
+    {GL_MAX_TEXTURE_LOD_BIAS, "MAX_TEXTURE_LOD_BIAS", FuryLimitType::kFloat},
+    {GL_MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS, "MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS", FuryLimitType::kInt},
+    {GL_MAX_TRANSFORM_FEEDBACK_SEPARATE_ATTRIBS, "MAX_TRANSFORM_FEEDBACK_SEPARATE_ATTRIBS", FuryLimitType::kInt},
+    {GL_MAX_TRANSFORM_FEEDBACK_SEPARATE_COMPONENTS, "MAX_TRANSFORM_FEEDBACK_SEPARATE_COMPONENTS", FuryLimitType::kInt},
+    {GL_MAX_UNIFORM_BLOCK_SIZE, "MAX_UNIFORM_BLOCK_SIZE", FuryLimitType::kInt64},
+    {GL_MAX_UNIFORM_BUFFER_BINDINGS, "MAX_UNIFORM_BUFFER_BINDINGS", FuryLimitType::kInt},
+    {GL_MAX_VARYING_COMPONENTS, "MAX_VARYING_COMPONENTS", FuryLimitType::kInt},
+    {GL_MAX_VERTEX_OUTPUT_COMPONENTS, "MAX_VERTEX_OUTPUT_COMPONENTS", FuryLimitType::kInt},
+    {GL_MAX_VERTEX_UNIFORM_BLOCKS, "MAX_VERTEX_UNIFORM_BLOCKS", FuryLimitType::kInt},
+    {GL_MAX_VERTEX_UNIFORM_COMPONENTS, "MAX_VERTEX_UNIFORM_COMPONENTS", FuryLimitType::kInt},
+    {GL_MIN_PROGRAM_TEXEL_OFFSET, "MIN_PROGRAM_TEXEL_OFFSET", FuryLimitType::kInt},
+    {GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT, "UNIFORM_BUFFER_OFFSET_ALIGNMENT", FuryLimitType::kInt},
+};
+
+// The configured value of a WebGL2 limit, or nullopt to ask the driver. Stored
+// as strings in the config because MAX_ELEMENT_INDEX and friends overflow the
+// config's 32-bit int.
+std::optional<ScriptValue> FuryConfiguredWebGL2Limit(ScriptState* script_state,
+                                                     GLenum pname) {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config) {
+    return std::nullopt;
+  }
+  for (const auto& limit : kFuryWebGL2Limits) {
+    if (limit.pname != pname) {
+      continue;
+    }
+    std::optional<std::string> value =
+        config->GetString(std::string("gpu.webgl2Params.") + limit.name);
+    if (!value) {
+      return std::nullopt;
+    }
+    switch (limit.type) {
+      case FuryLimitType::kInt: {
+        int parsed = 0;
+        if (base::StringToInt(*value, &parsed)) {
+          return WebGLAny(script_state, parsed);
+        }
+        break;
+      }
+      case FuryLimitType::kInt64: {
+        int64_t parsed = 0;
+        if (base::StringToInt64(*value, &parsed)) {
+          return WebGLAny(script_state, parsed);
+        }
+        break;
+      }
+      case FuryLimitType::kFloat: {
+        double parsed = 0;
+        if (base::StringToDouble(*value, &parsed)) {
+          return WebGLAny(script_state, static_cast<float>(parsed));
+        }
+        break;
+      }
+    }
+    return std::nullopt;
+  }
+  return std::nullopt;
+}
