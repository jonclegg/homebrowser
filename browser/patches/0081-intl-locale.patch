@@ -41,6 +43,48 @@ void NotifyLocaleChangeOnWorkerThread(WorkerThread* worker_thread) {
 LocaleController::LocaleController()
     : embedder_locale_(base::i18n::GetDefaultIcuLocale()) {}
 
+// static
+void LocaleController::Init() {
+  // Why this patch exists at all, when --lang looked like it should do the job.
+  //
+  // Intl resolves against ICU's process-global default locale, and Chromium
+  // sets that from the application locale — which on Windows comes from --lang
+  // but on macOS does not: measured on a build of this tree, `--lang=de` left
+  // Intl.DateTimeFormat().resolvedOptions().locale reporting "ru", the host's
+  // own language, and (123456.789).toLocaleString() formatting as "123 456,789".
+  // The German resources were present and loaded; the switch simply never
+  // reached SetICUDefaultLocale. The launcher still passes --lang, because the
+  // browser's own UI language should match what the profile claims, but the
+  // fact a page can read has to be set here.
+  //
+  // UpdateLocale, not SetLocaleOverride: the latter refuses when another agent
+  // holds an override, and DevTools is entitled to take one later. This is the
+  // embedder's own starting value, so it becomes what SetLocaleOverride("")
+  // restores to — which is why embedder_locale_ is rewritten with it.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<std::string> locale = config->GetString("locale.locale")) {
+      if (!locale->empty()) {
+        // A locale that does not parse would leave the process on the host's,
+        // silently. Checked here so the failure is a log line rather than a
+        // profile that looks configured and is not.
+        //
+        // Since 155 the controller holds a base::i18n::LanguageTag rather
+        // than a String, and SetLocaleOverride parses with this same function
+        // — so a locale this accepts is one DevTools could also set.
+        std::optional<base::i18n::LanguageTag> tag =
+            base::i18n::GetLanguageTagFromString(*locale);
+        if (!tag) {
+          LOG(ERROR) << "fury: invalid locale " << *locale;
+          return;
+        }
+        base::AutoLock locker(instance().lock_);
+        instance().UpdateLocale(*tag);
+        instance().embedder_locale_ = *tag;
+      }
+    }
+  }
+}
