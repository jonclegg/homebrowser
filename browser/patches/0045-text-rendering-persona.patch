 void WebFontRenderStyle::ApplyToSkFont(SkFont* font) const {
+  // A Mac persona sets glyphs the way CoreText does: no hinting, subpixel
+  // positions and linear advances. FreeType's hinting otherwise rounds every
+  // glyph's bounds to whole pixels, and canvas measureText() reports them:
+  // 12 for an ascent a Mac reports as 11.648 (Arial, 16px, measured).
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (config->GetString("text.rendering") == "mac") {
+      font->setHinting(SkFontHinting::kNone);
+      font->setEmbeddedBitmaps(use_bitmaps);
+      font->setForceAutoHinting(false);
+      font->setEdging(use_anti_alias ? SkFont::Edging::kAntiAlias
+                                     : SkFont::Edging::kAlias);
+      font->setSubpixel(true);
+      font->setLinearMetrics(true);
+      return;
+    }
+  }
+
   auto sk_hint_style = static_cast<SkFontHinting>(hint_style);
   font->setHinting(sk_hint_style);
   font->setEmbeddedBitmaps(use_bitmaps);
