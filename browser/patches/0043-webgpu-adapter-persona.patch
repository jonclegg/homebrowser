 wgpu::TextureFormat GPU::GetPreferredCanvasFormat() {
+  // Chrome on macOS and Windows prefers BGRA, on Linux and Android RGBA: a Mac
+  // persona answering rgba8unorm is a Linux build. Both formats configure a
+  // canvas on every platform, so the persona's answer is safe to give.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<std::string> format =
+            config->GetString("gpu.webgpu.preferredCanvasFormat")) {
+      if (*format == "bgra8unorm") {
+        return wgpu::TextureFormat::BGRA8Unorm;
+      }
+      if (*format == "rgba8unorm") {
+        return wgpu::TextureFormat::RGBA8Unorm;
+      }
+    }
+  }
 #if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_LINUX)
   // Interop of vulkan and GL has mesa driver bugs for BGRA format
   // See anglebug.com/40644739
