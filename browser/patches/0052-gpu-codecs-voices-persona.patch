+// Fury: the persona's hardware codecs, from a list of
+// "name;key=value;key=value" entries. Chrome on a Mac lists VideoToolbox's
+// H.264 High and H.265 after its software codecs, and a WebRTC offer numbers
+// its payload types from that list; without them the offer is shorter and
+// RED and ULPFEC take other numbers. Creating one of these codecs still fails,
+// as there is no hardware behind it.
+std::vector<webrtc::SdpVideoFormat> PersonaFormats(std::string_view path) {
+  std::vector<webrtc::SdpVideoFormat> formats;
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config) {
+    return formats;
+  }
+  std::optional<std::vector<std::string>> entries = config->GetStringList(path);
+  if (!entries) {
+    return formats;
+  }
+  for (const std::string& entry : *entries) {
+    std::vector<std::string> fields = base::SplitString(
+        entry, ";", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (fields.empty()) {
+      continue;
+    }
+    webrtc::CodecParameterMap parameters;
+    for (size_t index = 1; index < fields.size(); ++index) {
+      std::vector<std::string> key_value = base::SplitString(
+          fields[index], "=", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+      if (key_value.size() == 2) {
+        parameters[key_value[0]] = key_value[1];
+      }
+    }
+    formats.emplace_back(fields[0], parameters);
+  }
+  return formats;
+}
