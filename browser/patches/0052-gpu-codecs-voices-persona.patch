+
+bool SpeechSynthesis::SetSyntheticVoices(bool network_only) {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config) {
+    return false;
+  }
+  std::optional<std::vector<std::string>> synthetic =
+      config->GetStringList("speech.syntheticVoices");
+  if (!synthetic) {
+    return false;
+  }
+  voice_list_.clear();
+  for (const std::string& entry : *synthetic) {
+    std::vector<std::string> fields = base::SplitString(
+        entry, "\t", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+    if (fields.size() != 5 || (network_only && fields[2] == "1")) {
+      continue;
+    }
+    auto voice = mojom::blink::SpeechSynthesisVoice::New();
+    voice->name = String::FromUtf8(fields[0]);
+    voice->lang = String::FromUtf8(fields[1]);
+    voice->is_local_service = fields[2] == "1";
+    voice->is_default = network_only ? voice_list_.empty() : fields[3] == "1";
+    voice->voice_uri = String::FromUtf8(fields[4]);
+    voice_list_.push_back(
+        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(voice)));
+  }
+  return true;
+}
+
+void SpeechSynthesis::FinishSyntheticVoices() {
+  SetSyntheticVoices(/*network_only=*/false);
   VoicesDidChange();
 }
 
